# Copy to .env and fill in any you have. Providers without a key are skipped; order lives in providers.json.
# Free tiers (check current limits): Gemini https://aistudio.google.com/apikey  ·  Groq https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
CEREBRAS_API_KEY=

# Optional: override a provider's model list (comma-separated), e.g.
# NARRATOR_MODELS_GROQ=llama-3.3-70b-versatile
# PORT=5173
