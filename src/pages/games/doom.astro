.game-header, .modal-window, .back-btn, .sys-btn { pointer-events: auto; }
#crosshair { position: absolute; left: 50%; top: 50%; width: 3px; height: 3px; transform: translate(-50%, -50%); border-radius: 50%; background: rgba(232, 160, 96, 0.95); box-shadow: 0 0 0 1.5px rgba(61, 54, 48, 0.4), 0 0 6px rgba(232, 160, 96, 0.5); z-index: 20; }
