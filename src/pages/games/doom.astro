#health-bar-container { width: 200px; height: 20px; background: rgba(61, 54, 48, 0.8); border-radius: 4px; overflow: hidden; position: relative; display: flex; align-items: center; justify-content: center; }
#health-bar { height: 100%; width: 100%; background: linear-gradient(90deg, #00AA44, #00FF66); transition: width 0.2s ease; }
#health-text { position: absolute; font-size: 0.75rem; font-weight: 700; color: white; text-shadow: 0 1px 2px rgba(0,0,0,0.5); }
#bot-count { font-size: 0.85rem; font-weight: 600; color: #8B3030; text-shadow: 0 1px 2px rgba(255,255,255,0.3); }
.game-header { position: absolute; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; background: linear-gradient(to bottom, rgba(196, 184, 168, 0.9), transparent); z-index: 30; }
.back-btn { text-decoration: none; color: #5A5048; border: 1px solid rgba(90, 80, 72, 0.3); border-radius: 6px; padding: 0.4rem 0.7rem; font-size: 0.85rem; background: rgba(232, 221, 208, 0.6); backdrop-filter: blur(8px); display: flex; align-items: center; gap: 0.3rem; transition: all 0.2s ease; }
