.game-header { position: absolute; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; background: linear-gradient(to bottom, rgba(196, 184, 168, 0.9), rgba(196, 184, 168, 0)); z-index: 30; }
.back-btn { text-decoration: none; color: #5A5048; border: 1px solid rgba(90, 80, 72, 0.3); border-radius: 6px; padding: 0.5rem 0.8rem; font-size: 0.9rem; background: rgba(232, 221, 208, 0.6); backdrop-filter: blur(8px); display: flex; align-items: center; gap: 0.4rem; transition: all 0.2s ease; }
.back-btn:hover { background: rgba(232, 160, 96, 0.2); border-color: #E8A060; color: #B87050; transform: translateX(-2px); }
.target-title { font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; letter-spacing: 0.15em; color: #4A4238; margin: 0; text-transform: uppercase; }
.status-indicator { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #6B6358; display: flex; align-items: center; gap: 0.5rem; background: rgba(196, 184, 168, 0.6); border: 1px solid rgba(90, 80, 72, 0.2); padding: 0.4rem 0.8rem; border-radius: 6px; backdrop-filter: blur(8px); }
.dot { width: 6px; height: 6px; background-color: #E8A060; border-radius: 50%; box-shadow: 0 0 6px #E8A060; animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.6; transform: scale(0.85); } }
.blocker { position: absolute; inset: 0; background: rgba(61, 54, 48, 0.75); backdrop-filter: blur(10px); display: flex; justify-content: center; align-items: center; opacity: 0; pointer-events: none; transition: opacity 0.4s ease; z-index: 50; }
.blocker.visible { opacity: 1; pointer-events: auto; }
.modal-window { width: min(420px, 90vw); background: linear-gradient(160deg, #E8DDD0, #D4C8B8); border: 1px solid rgba(184, 112, 80, 0.4); border-radius: 12px; padding: 2.5rem; box-shadow: 0 25px 50px rgba(61, 54, 48, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3); transform: translateY(20px) scale(0.95); transition: all 0.4s ease; text-align: center; }
.blocker.visible .modal-window { transform: translateY(0) scale(1); }
.modal-window h2 { margin: 0 0 0.5rem; font-family: var(--font-display); font-size: 2rem; color: #4A4238; letter-spacing: 0.05em; }
.modal-desc { margin: 0 0 1.5rem; color: #6B6358; font-size: 0.95rem; line-height: 1.5; }
.controls-list { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.8rem; text-align: left; background: rgba(255, 255, 255, 0.3); border-radius: 8px; padding: 1.2rem; border: 1px solid rgba(184, 112, 80, 0.15); }
.controls-list li { font-size: 0.9rem; color: #4A4238; display: flex; align-items: center; gap: 0.8rem; }
.controls-list li strong { color: #B87050; background: rgba(232, 160, 96, 0.15); border: 1px solid rgba(232, 160, 96, 0.25); padding: 0.25rem 0.6rem; border-radius: 4px; font-size: 0.8rem; letter-spacing: 0.05em; font-weight: 700; }
.sys-btn { background: linear-gradient(135deg, #E8A060, #D99575); color: #3D3630; border: none; padding: 0.9rem 2rem; font-family: var(--font-body); font-size: 0.95rem; font-weight: 700; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; width: 100%; letter-spacing: 0.08em; text-transform: uppercase; box-shadow: 0 4px 12px rgba(184, 112, 80, 0.3); }
.sys-btn:hover { background: linear-gradient(135deg, #FFC490, #E8A060); transform: translateY(-2px); box-shadow: 0 6px 18px rgba(232, 160, 96, 0.4); }
.sys-btn:active { transform: translateY(0); }
</style>
