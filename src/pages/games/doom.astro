---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="The DOOM Showcase | shvnk.in">
  <main class="game-container">
    <div id="game-canvas-container"></div>
    <div id="ui-layer">
      <div id="crosshair"></div>
      <header class="game-header">
        <div class="header-left">
          <a href="/" class="back-btn" aria-label="Exit"><span class="back-icon">←</span><span class="back-text">Exit</span></a>
        </div>
        <div class="header-center"><h1 class="target-title">SECTOR 7 ARENA</h1></div>
        <div class="header-right"><span class="status-indicator"><span class="dot"></span> Online</span></div>
      </header>
      <div id="blocker" class="blocker visible">
        <div class="modal-window">
          <h2>Sector 7 Arena</h2>
          <p class="modal-desc">Close-quarters combat zone. Multiplayer ready.</p>
          <ul class="controls-list">
            <li><strong>WASD</strong> move</li>
            <li><strong>Mouse</strong> look</li>
            <li><strong>Click</strong> fire</li>
          </ul>
          <button id="instructions" class="sys-btn">Enter Arena</button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
    import * as THREE from 'three';
    import { PointerLockControls } from 'three/examples/jsm/controls/PointerLockControls.js';

    // === PALETTE ===
    const PALETTE = {
        concrete: { base: 0xC4B8A8, dark: 0x9B8F7E, light: 0xE8DDD0, weathered: 0xA69A89 },
        rust: { base: 0xB87050, dark: 0x8B4F35, light: 0xD99575 },
        copper: { base: 0xE8A060, glow: 0xFFC490, dark: 0xC47A35 },
        moss: { base: 0x6B7B4C, dark: 0x4A5A35 }
    };

    // === SETUP ===
    const container = document.getElementById('game-canvas-container');
    const blocker = document.getElementById('blocker');
    const startBtn = document.getElementById('instructions');

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xD4C8B8);
    scene.fog = new THREE.FogExp2(0xD4C8B8, 0.006);

    let width = window.innerWidth;
    let height = window.innerHeight;

    const camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 200);
    camera.position.set(0, 1.6, 20);

    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(width, height);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0;
    if (container) container.appendChild(renderer.domElement);

    const controls = new PointerLockControls(camera, renderer.domElement);

    startBtn?.addEventListener('click', () => { controls.lock(); initAudio(); });
    controls.addEventListener('lock', () => blocker?.classList.remove('visible'));
    controls.addEventListener('unlock', () => blocker?.classList.add('visible'));
    scene.add(controls.object);

    // === AUDIO - Minimal Sharp Gun Sound ===
    let audioCtx;
    function initAudio() {
        if (audioCtx) return;
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }

    function playShoot() {
        if (!audioCtx || audioCtx.state !== 'running') return;
        const now = audioCtx.currentTime;
        
        // Sharp metallic crack - very short
        const osc = audioCtx.createOscillator();
        osc.type = 'square';
        osc.frequency.setValueAtTime(180, now);
        osc.frequency.exponentialRampToValueAtTime(40, now + 0.04);
        
        const noise = audioCtx.createOscillator();
        noise.type = 'sawtooth';
        noise.frequency.setValueAtTime(800, now);
        noise.frequency.exponentialRampToValueAtTime(100, now + 0.03);
        
        const filter = audioCtx.createBiquadFilter();
        filter.type = 'highpass';
        filter.frequency.value = 400;
        filter.Q.value = 2;
        
        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0.35, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
        
        osc.connect(filter);
        noise.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);
        
        osc.start(now);
        noise.start(now);
        osc.stop(now + 0.08);
        noise.stop(now + 0.08);
    }

    function playJump() {
        if (!audioCtx || audioCtx.state !== 'running') return;
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(80, now);
        osc.frequency.linearRampToValueAtTime(140, now + 0.08);
        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0.06, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.2);
    }

    // === MATERIALS ===
    const mat = {
        concrete: [
            new THREE.MeshStandardMaterial({ color: PALETTE.concrete.base, roughness: 0.95, metalness: 0.05 }),
            new THREE.MeshStandardMaterial({ color: PALETTE.concrete.dark, roughness: 0.9, metalness: 0.08 }),
            new THREE.MeshStandardMaterial({ color: PALETTE.concrete.weathered, roughness: 0.85, metalness: 0.06 })
        ],
        rust: [
            new THREE.MeshStandardMaterial({ color: PALETTE.rust.base, roughness: 0.8, metalness: 0.4 }),
            new THREE.MeshStandardMaterial({ color: PALETTE.rust.dark, roughness: 0.85, metalness: 0.35 })
        ],
        copper: new THREE.MeshStandardMaterial({ color: PALETTE.copper.base, emissive: PALETTE.copper.glow, emissiveIntensity: 1.5, roughness: 0.3, metalness: 0.9 })
    };

    // === COLLISION ===
    const collisionBoxes = [];

    function addBox(mesh) { collisionBoxes.push(new THREE.Box3().setFromObject(mesh)); }
    
    function wall(x, z, w, d, h, material = mat.concrete[0]) {
        const geo = new THREE.BoxGeometry(w, h, d);
        const mesh = new THREE.Mesh(geo, material);
        mesh.position.set(x, h / 2, z);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        scene.add(mesh);
        addBox(mesh);
        return mesh;
    }
    
    function halfWall(x, z, w, d, material = mat.concrete[1]) {
        return wall(x, z, w, d, 1.0, material);
    }
    
    function pillar(x, z, size = 0.8, height = 4) {
        const geo = new THREE.BoxGeometry(size, height, size);
        const mesh = new THREE.Mesh(geo, mat.concrete[Math.floor(Math.random() * 3)]);
        mesh.position.set(x, height / 2, z);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        scene.add(mesh);
        addBox(mesh);
        return mesh;
    }

    // === WEAPON ===
    const gunGroup = new THREE.Group();
    const gunMat = new THREE.MeshStandardMaterial({ color: PALETTE.rust.dark, metalness: 0.8, roughness: 0.3 });
    
    const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.45, 12), gunMat);
    barrel.rotation.x = Math.PI / 2;
    barrel.position.z = -0.22;
    gunGroup.add(barrel);

    const cylinder = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 0.12, 8), gunMat);
    cylinder.rotation.x = Math.PI / 2;
    cylinder.position.z = -0.02;
    gunGroup.add(cylinder);

    const frame = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.1, 0.2), gunMat);
    frame.position.z = 0.08;
    gunGroup.add(frame);

    const grip = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.12, 0.1), new THREE.MeshStandardMaterial({ color: 0x4A3528, roughness: 0.9 }));
    grip.position.set(0, -0.06, 0.18);
    grip.rotation.x = -0.25;
    gunGroup.add(grip);

    const core = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.015, 0.08, 8), mat.copper);
    core.rotation.x = Math.PI / 2;
    core.position.set(0, 0.055, -0.04);
    gunGroup.add(core);

    const muzzleFlash = new THREE.PointLight(PALETTE.copper.glow, 0, 6);
    muzzleFlash.position.set(0, 0, -0.5);
    gunGroup.add(muzzleFlash);

    gunGroup.position.set(0.3, -0.32, -0.45);
    camera.add(gunGroup);
    scene.add(camera);

    // === RECOIL ===
    let recoilPos = 0, recoilVel = 0, recoilTarget = 0;
    const RECOIL_K = 1400, RECOIL_D = 40;

    // === MAP: MULTIPLAYER ARENA ===
    const MAP_SIZE = 50;
    const WALL_H = 4.5;
    const CORRIDOR_W = 3.5;
    const ROOM_W = 8;

    // Floor
    const floorGeo = new THREE.PlaneGeometry(120, 120, 60, 60);
    const floorPos = floorGeo.attributes.position;
    for (let i = 0; i < floorPos.count; i++) {
        const x = floorPos.getX(i);
        const y = floorPos.getY(i);
        floorPos.setZ(i, (Math.sin(x * 0.2) + Math.cos(y * 0.2)) * 0.08);
    }
    floorGeo.computeVertexNormals();
    const floorMesh = new THREE.Mesh(floorGeo, new THREE.MeshStandardMaterial({ color: PALETTE.concrete.base, roughness: 0.92, metalness: 0.03 }));
    floorMesh.rotation.x = -Math.PI / 2;
    floorMesh.receiveShadow = true;
    scene.add(floorMesh);

    // Perimeter walls
    wall(0, -MAP_SIZE, MAP_SIZE * 2, 1, WALL_H);
    wall(0, MAP_SIZE, MAP_SIZE * 2, 1, WALL_H);
    wall(-MAP_SIZE, 0, 1, MAP_SIZE * 2, WALL_H);
    wall(MAP_SIZE, 0, 1, MAP_SIZE * 2, WALL_H);

    // === CENTRAL HUB (Cross-shaped with cover) ===
    // Central pillar cluster
    pillar(-2, -2, 1.2, 3);
    pillar(2, -2, 1.2, 3);
    pillar(-2, 2, 1.2, 3);
    pillar(2, 2, 1.2, 3);

    // Central cover boxes
    wall(0, 0, 2, 2, 1.2, mat.rust[0]);
    wall(-6, 0, 1.5, 6, 1.0, mat.concrete[1]);
    wall(6, 0, 1.5, 6, 1.0, mat.concrete[1]);
    wall(0, -6, 6, 1.5, 1.0, mat.concrete[1]);
    wall(0, 6, 6, 1.5, 1.0, mat.concrete[1]);

    // Corridors from center
    // North corridor
    wall(-CORRIDOR_W/2, -12, 1, 14, WALL_H);
    wall(CORRIDOR_W/2, -12, 1, 14, WALL_H);

    // South corridor  
    wall(-CORRIDOR_W/2, 12, 1, 14, WALL_H);
    wall(CORRIDOR_W/2, 12, 1, 14, WALL_H);

    // East corridor
    wall(12, -CORRIDOR_W/2, 14, 1, WALL_H);
    wall(12, CORRIDOR_W/2, 14, 1, WALL_H);

    // West corridor
    wall(-12, -CORRIDOR_W/2, 14, 1, WALL_H);
    wall(-12, CORRIDOR_W/2, 14, 1, WALL_H);

    // === NORTH COMPLEX (2 rooms connected) ===
    function buildNorthComplex() {
        const baseZ = -25;
        
        // Outer walls
        wall(0, baseZ - 7, ROOM_W * 2 + 2, 1, WALL_H);
        wall(-ROOM_W - 1, baseZ, 1, 14, WALL_H);
        wall(ROOM_W + 1, baseZ, 1, 14, WALL_H);
        
        // Inner divider with doorway
        wall(-2, baseZ, 1, 8, WALL_H);
        wall(4, baseZ, 1, 8, WALL_H);
        
        // Room furniture/cover
        wall(-ROOM_W, baseZ - 3, 2, 2, 1.0, mat.rust[1]);
        wall(-ROOM_W, baseZ + 3, 1, 3, 1.2, mat.concrete[2]);
        wall(ROOM_W, baseZ - 2, 3, 1.5, 0.8, mat.rust[0]);
        
        // Entry corridor cover
        halfWall(0, baseZ + 5, 2, 2, mat.concrete[1]);
        
        // Barrels
        createBarrel(-ROOM_W + 2, baseZ - 4, true);
        createBarrel(ROOM_W - 3, baseZ + 2, false);
    }

    // === SOUTH COMPLEX ===
    function buildSouthComplex() {
        const baseZ = 25;
        
        wall(0, baseZ + 7, ROOM_W * 2 + 2, 1, WALL_H);
        wall(-ROOM_W - 1, baseZ, 1, 14, WALL_H);
        wall(ROOM_W + 1, baseZ, 1, 14, WALL_H);
        
        wall(-3, baseZ, 1.5, 10, WALL_H);
        wall(5, baseZ, 1.5, 10, WALL_H);
        
        halfWall(-ROOM_W + 1, baseZ - 2, 1.5, 2, mat.rust[1]);
        wall(ROOM_W, baseZ + 2, 2.5, 2, 1.0, mat.concrete[2]);
        
        createBarrel(ROOM_W - 2, baseZ - 3, true);
        createBarrel(-ROOM_W + 3, baseZ + 1, false);
    }

    // === EAST WING ===
    function buildEastWing() {
        const baseX = 25;
        
        wall(baseX + 7, 0, 1, ROOM_W * 2 + 2, WALL_H);
        wall(baseX, -ROOM_W - 1, 14, 1, WALL_H);
        wall(baseX, ROOM_W + 1, 14, 1, WALL_H);
        
        // Vertical divider
        wall(baseX, -2, 1, 5, WALL_H);
        wall(baseX, 4, 1, 5, WALL_H);
        
        // Cover
        halfWall(baseX - 3, -ROOM_W, 2, 2, mat.rust[0]);
        wall(baseX + 2, ROOM_W, 2, 2.5, 0.9, mat.concrete[1]);
        pillar(baseX - 2, ROOM_W - 2, 0.9, 2.5);
        
        createBarrel(baseX + 3, -ROOM_W + 2, true);
    }

    // === WEST WING ===
    function buildWestWing() {
        const baseX = -25;
        
        wall(baseX - 7, 0, 1, ROOM_W * 2 + 2, WALL_H);
        wall(baseX, -ROOM_W - 1, 14, 1, WALL_H);
        wall(baseX, ROOM_W + 1, 14, 1, WALL_H);
        
        wall(baseX, -3, 1, 6, WALL_H);
        wall(baseX, 5, 1, 6, WALL_H);
        
        halfWall(baseX + 2, -ROOM_W + 1, 1.5, 2.5, mat.rust[1]);
        wall(baseX - 2, ROOM_W - 2, 2, 2, 0.8, mat.concrete[2]);
        
        createBarrel(baseX - 3, ROOM_W - 3, true);
        createBarrel(baseX + 1, 2, false);
    }

    // === CORNER BUNKERS (Spawn areas) ===
    function buildBunker(x, z, rotY) {
        const group = new THREE.Group();
        
        // U-shaped bunker
        halfWall(x - 2, z, 0.5, 5, mat.rust[0]);
        halfWall(x + 2, z, 0.5, 5, mat.rust[0]);
        halfWall(x, z - 2, 5, 0.5, mat.rust[0]);
        
        // Corner pillars
        pillar(x - 3, z - 3, 0.6, 2);
        pillar(x + 3, z - 3, 0.6, 2);
        
        // Ammo crate
        const crate = new THREE.Mesh(
            new THREE.BoxGeometry(1.2, 0.8, 0.8),
            mat.concrete[1]
        );
        crate.position.set(x, 0.4, z + 1);
        crate.rotation.y = rotY + 0.3;
        crate.castShadow = true;
        scene.add(crate);
        
        return group;
    }

    // 4 corner bunkers
    buildBunker(-42, -42, 0);
    buildBunker(42, -42, 0);
    buildBunker(-42, 42, 0);
    buildBunker(42, 42, 0);

    // === COVER THROUGHOUT CORRIDORS ===
    function addCorridorCover() {
        // North passage
        halfWall(0, -18, 1.5, 1.5, mat.concrete[1]);
        pillar(-1.5, -15, 0.7, 2.5);
        pillar(1.5, -15, 0.7, 2.5);
        
        // South passage
        halfWall(0, 18, 1.5, 1.5, mat.concrete[1]);
        
        // East passage
        halfWall(18, 0, 1.5, 1.5, mat.rust[0]);
        pillar(15, -1.5, 0.7, 2.5);
        pillar(15, 1.5, 0.7, 2.5);
        
        // West passage
        halfWall(-18, 0, 1.5, 1.5, mat.rust[0]);
        createBarrel(-15, 2, true);
    }

    // === SCATTERED COVER ELEMENTS ===
    function createBarrel(x, z, glowing) {
        const geo = new THREE.CylinderGeometry(0.35, 0.4, 1.1, 10);
        const m = glowing ? mat.copper : mat.rust[Math.floor(Math.random() * 2)];
        const barrel = new THREE.Mesh(geo, m);
        barrel.position.set(x, 0.55, z);
        barrel.castShadow = true;
        barrel.receiveShadow = true;
        scene.add(barrel);
        addBox(barrel);
        
        if (glowing) {
            const light = new THREE.PointLight(PALETTE.copper.glow, 1.0, 6);
            light.position.set(x, 1.5, z);
            scene.add(light);
        }
    }

    function createCrate(x, z, w, h, d) {
        const crate = new THREE.Mesh(
            new THREE.BoxGeometry(w, h, d),
            mat.concrete[Math.floor(Math.random() * 3)]
        );
        crate.position.set(x, h/2, z);
        crate.rotation.y = Math.random() * 0.4 - 0.2;
        crate.castShadow = true;
        crate.receiveShadow = true;
        scene.add(crate);
        addBox(crate);
    }

    function createLongCover(x, z, len, angle = 0) {
        const cover = new THREE.Mesh(
            new THREE.BoxGeometry(len, 1.0, 0.6),
            mat.concrete[1]
        );
        cover.position.set(x, 0.5, z);
        cover.rotation.y = angle;
        cover.castShadow = true;
        cover.receiveShadow = true;
        scene.add(cover);
        addBox(cover);
    }

    // Build structures
    buildNorthComplex();
    buildSouthComplex();
    buildEastWing();
    buildWestWing();
    addCorridorCover();

    // Additional cover in open areas
    createLongCover(-20, -10, 4, 0.3);
    createLongCover(20, 10, 4, -0.2);
    createLongCover(-10, 20, 3, 0.5);
    createLongCover(10, -20, 3, -0.4);

    // Crates scattered
    for (let i = 0; i < 25; i++) {
        const angle = Math.random() * Math.PI * 2;
        const dist = 8 + Math.random() * 35;
        const x = Math.cos(angle) * dist;
        const z = Math.sin(angle) * dist;
        
        // Don't place in corridors
        if (Math.abs(x) < 4 && Math.abs(z) > 10) continue;
        if (Math.abs(z) < 4 && Math.abs(x) > 10) continue;
        
        const w = 0.7 + Math.random() * 0.8;
        const h = 0.6 + Math.random() * 0.6;
        createCrate(x, z, w, h, w);
    }

    // Barrels scattered
    for (let i = 0; i < 12; i++) {
        const angle = Math.random() * Math.PI * 2;
        const dist = 10 + Math.random() * 30;
        const x = Math.cos(angle) * dist;
        const z = Math.sin(angle) * dist;
        if (Math.abs(x) < 5 && Math.abs(z) < 5) continue;
        createBarrel(x, z, Math.random() > 0.7);
    }

    // === LIGHTING ===
    const ambientLight = new THREE.AmbientLight(0xE8D4B8, 0.45);
    scene.add(ambientLight);

    const sunLight = new THREE.DirectionalLight(0xFFD4A8, 1.0);
    sunLight.position.set(-25, 40, -15);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 4096;
    sunLight.shadow.mapSize.height = 4096;
    sunLight.shadow.camera.near = 1;
    sunLight.shadow.camera.far = 120;
    sunLight.shadow.camera.left = -60;
    sunLight.shadow.camera.right = 60;
    sunLight.shadow.camera.top = 60;
    sunLight.shadow.camera.bottom = -60;
    sunLight.shadow.bias = -0.0003;
    scene.add(sunLight);

    const rimLight = new THREE.DirectionalLight(0xB8C8E8, 0.2);
    rimLight.position.set(30, 20, 25);
    scene.add(rimLight);

    // Copper lights in key areas
    const lightPositions = [
        [0, 4.5], [-25, 0], [25, 0], [0, -25], [0, 25],
        [-20, -20], [20, -20], [-20, 20], [20, 20]
    ];
    lightPositions.forEach(([x, z]) => {
        const light = new THREE.PointLight(PALETTE.copper.glow, 0.8, 12);
        light.position.set(x, 3, z);
        scene.add(light);
    });

    // === PROJECTILES ===
    const projectiles = [];

    document.addEventListener('mousedown', (e) => {
        if (!controls.isLocked || e.button !== 0) return;
        playShoot();
        recoilTarget = 0.12;
        muzzleFlash.intensity = 2.5;
        setTimeout(() => muzzleFlash.intensity = 0, 40);

        const proj = new THREE.Mesh(
            new THREE.SphereGeometry(0.05, 8, 8),
            new THREE.MeshStandardMaterial({ color: PALETTE.copper.glow, emissive: PALETTE.copper.glow, emissiveIntensity: 3, roughness: 0.2, metalness: 0.8 })
        );

        const spawnPos = new THREE.Vector3();
        barrel.getWorldPosition(spawnPos);
        proj.position.copy(spawnPos);

        const dir = new THREE.Vector3();
        camera.getWorldDirection(dir);

        const pLight = new THREE.PointLight(PALETTE.copper.glow, 1.5, 8);
        proj.add(pLight);

        scene.add(proj);
        projectiles.push({ mesh: proj, dir: dir, life: 1.2 });
    });

    // === PHYSICS ===
    const SCALE = 1.6 / 56;
    const GRAVITY = 800 * SCALE;
    const JUMP_IMPULSE = 270 * SCALE;
    const MAX_WALK = 320 * SCALE;
    const ACCEL = 10 * MAX_WALK;
    const FRICTION_K = 10;
    const EPSILON = 0.03125;

    let worldVelocity = new THREE.Vector3();
    let isGrounded = false;
    let headBobPhase = 0;
    let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false;
    let prevTime = performance.now();
    const playerRadius = 0.45;

    document.addEventListener('keydown', (e) => {
        if (!controls.isLocked) return;
        switch (e.code) {
            case 'ArrowUp': case 'KeyW': moveForward = true; break;
            case 'ArrowLeft': case 'KeyA': moveLeft = true; break;
            case 'ArrowDown': case 'KeyS': moveBackward = true; break;
            case 'ArrowRight': case 'KeyD': moveRight = true; break;
            case 'Space': if (isGrounded) { worldVelocity.y = JUMP_IMPULSE; playJump(); } break;
        }
    });

    document.addEventListener('keyup', (e) => {
        switch (e.code) {
            case 'ArrowUp': case 'KeyW': moveForward = false; break;
            case 'ArrowLeft': case 'KeyA': moveLeft = false; break;
            case 'ArrowDown': case 'KeyS': moveBackward = false; break;
            case 'ArrowRight': case 'KeyD': moveRight = false; break;
        }
    });

    function checkCollision(position) {
        const playerBox = new THREE.Box3(
            new THREE.Vector3(position.x - playerRadius, 0, position.z - playerRadius),
            new THREE.Vector3(position.x + playerRadius, 1.6, position.z + playerRadius)
        );
        for (const box of collisionBoxes) {
            if (playerBox.intersectsBox(box)) return true;
        }
        return false;
    }

    function animate() {
        requestAnimationFrame(animate);
        const time = performance.now();

        if (controls.isLocked) {
            const delta = Math.min((time - prevTime) / 1000, 0.1);

            // Recoil spring
            recoilVel += (-RECOIL_K * (recoilPos - recoilTarget) - RECOIL_D * recoilVel) * delta;
            recoilPos += recoilVel * delta;
            gunGroup.position.z = -0.45 + recoilPos;

            // Projectiles
            for (let i = projectiles.length - 1; i >= 0; i--) {
                const p = projectiles[i];
                p.life -= delta;
                if (p.life <= 0) { scene.remove(p.mesh); projectiles.splice(i, 1); continue; }
                p.mesh.position.addScaledVector(p.dir, 55 * delta);
                const pBox = new THREE.Box3().setFromObject(p.mesh);
                for (const box of collisionBoxes) {
                    if (pBox.intersectsBox(box)) { scene.remove(p.mesh); projectiles.splice(i, 1); break; }
                }
            }

            // Physics
            if (isGrounded) {
                worldVelocity.x -= worldVelocity.x * FRICTION_K * delta;
                worldVelocity.z -= worldVelocity.z * FRICTION_K * delta;
            } else {
                worldVelocity.x -= worldVelocity.x * (FRICTION_K * 0.1) * delta;
                worldVelocity.z -= worldVelocity.z * (FRICTION_K * 0.1) * delta;
            }
            worldVelocity.y -= GRAVITY * delta;

            const lookDir = new THREE.Vector3();
            camera.getWorldDirection(lookDir);
            lookDir.y = 0;
            lookDir.normalize();
            const rightDir = new THREE.Vector3().crossVectors(lookDir, camera.up).normalize();

            const moveDir = new THREE.Vector3();
            if (moveForward) moveDir.add(lookDir);
            if (moveBackward) moveDir.sub(lookDir);
            if (moveLeft) moveDir.sub(rightDir);
            if (moveRight) moveDir.add(rightDir);
            if (moveDir.length() > 0) moveDir.normalize();

            const currentAccel = isGrounded ? ACCEL : ACCEL * 0.25;
            worldVelocity.x += moveDir.x * currentAccel * delta;
            worldVelocity.z += moveDir.z * currentAccel * delta;

            const horizRun = Math.sqrt(worldVelocity.x ** 2 + worldVelocity.z ** 2);
            if (horizRun > MAX_WALK) {
                const ratio = MAX_WALK / horizRun;
                worldVelocity.x *= ratio;
                worldVelocity.z *= ratio;
            }

            const currentObj = controls.object;

            currentObj.position.x += worldVelocity.x * delta;
            if (checkCollision(currentObj.position)) {
                currentObj.position.x -= (worldVelocity.x * delta) + (Math.sign(worldVelocity.x) * EPSILON);
                worldVelocity.x = 0;
            }

            currentObj.position.z += worldVelocity.z * delta;
            if (checkCollision(currentObj.position)) {
                currentObj.position.z -= (worldVelocity.z * delta) + (Math.sign(worldVelocity.z) * EPSILON);
                worldVelocity.z = 0;
            }

            currentObj.position.y += worldVelocity.y * delta;
            isGrounded = false;
            if (currentObj.position.y < 1.6) {
                currentObj.position.y = 1.6;
                worldVelocity.y = 0;
                isGrounded = true;
            } else if (checkCollision(currentObj.position)) {
                currentObj.position.y -= worldVelocity.y * delta;
                worldVelocity.y = 0;
                if (worldVelocity.y <= 0) isGrounded = true;
            }

            // Head bob
            if (isGrounded && horizRun > 0.1) {
                headBobPhase += delta * 10 * (horizRun / MAX_WALK);
                currentObj.position.y = 1.6 + 0.04 * Math.sin(headBobPhase);
            } else {
                headBobPhase = 0;
            }
        }

        prevTime = time;
        renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
        if (!camera || !renderer) return;
        width = window.innerWidth;
        height = window.innerHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
    });

    animate();
</script>

