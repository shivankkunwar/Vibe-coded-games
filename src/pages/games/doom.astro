---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="The DOOM Showcase | shvnk.in">
  <main class="game-container">
    <div id="game-canvas-container"></div>

    <div id="ui-layer">
      <!-- Crosshair -->
      <div id="crosshair"></div>

      <!-- Header overlaid on the 3D scene -->
      <header class="game-header">
        <div class="header-left">
          <a href="/" class="back-btn" aria-label="Exit Showcase">
            <span class="back-icon">←</span>
            <span class="back-text">Exit</span>
          </a>
        </div>
        <div class="header-center">
            <h1 class="target-title">ARCHITECTURAL SHOWCASE</h1>
        </div>
        <div class="header-right">
           <span class="status-indicator"><span class="dot"></span> Online</span>
        </div>
      </header>

      <!-- The blocker overlay for PointerLock -->
      <div id="blocker" class="blocker visible">
        <div class="modal-window">
          <h2>Initialize Sequence</h2>
          <p class="modal-desc">Enter the highly-optimized immersive showcase.</p>
          <ul class="controls-list">
            <li><strong>WASD</strong> to move</li>
            <li><strong>Mouse</strong> to look</li>
          </ul>
          <button id="instructions" class="sys-btn">Start Simulation</button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
    import * as THREE from 'three';
    import { PointerLockControls } from 'three/examples/jsm/controls/PointerLockControls.js';

    // UI elements
    const container = document.getElementById('game-canvas-container');
    const blocker = document.getElementById('blocker');
    const startBtn = document.getElementById('instructions');

    // Scene Setup
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0a0f); // Dark architectural grey
    scene.fog = new THREE.FogExp2(0x0a0a0f, 0.015);

    // Dynamic Sizing based on the window
    let width = window.innerWidth;
    let height = window.innerHeight;

    const camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 100);
    camera.position.y = 1.6; // Average eye height

    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(width, height);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    // Inject canvas into wrapper
    if (container) {
        container.appendChild(renderer.domElement);
    }
    
    // Controls
    const controls = new PointerLockControls(camera, renderer.domElement);

    startBtn?.addEventListener('click', function () {
        controls.lock();
    });

    controls.addEventListener('lock', function () {
        blocker?.classList.remove('visible');
    });

    controls.addEventListener('unlock', function () {
        blocker?.classList.add('visible');
    });

    scene.add(controls.object);

    // Aesthetics logic (Brighter, more visible materials)
    function createGridTexture(bgColor, lineColor) {
        const canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 512;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, 512, 512);
        ctx.strokeStyle = lineColor;
        ctx.lineWidth = 4;
        for(let i=0; i<=512; i+=64) {
            ctx.beginPath();
            ctx.moveTo(i, 0); ctx.lineTo(i, 512);
            ctx.moveTo(0, i); ctx.lineTo(512, i);
            ctx.stroke();
        }
        const tex = new THREE.CanvasTexture(canvas);
        tex.wrapS = THREE.RepeatWrapping;
        tex.wrapT = THREE.RepeatWrapping;
        return tex;
    }

    const wallTex = createGridTexture('#333344', '#555566');
    wallTex.repeat.set(4, 1);
    
    const floorTex = createGridTexture('#1a1a24', '#2a2a3a');
    floorTex.repeat.set(20, 20);

    const wallMaterial = new THREE.MeshStandardMaterial({
        map: wallTex,
        roughness: 0.6,
        metalness: 0.1
    });

    const floorMaterial = new THREE.MeshStandardMaterial({ 
        map: floorTex,
        roughness: 0.9, 
        metalness: 0.2 
    });

    const collisionBoxes = [];

    function createWall(w, h, d, x, z) {
        const geometry = new THREE.BoxGeometry(w, h, d);
        const mesh = new THREE.Mesh(geometry, wallMaterial);
        mesh.position.set(x, h/2, z);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        scene.add(mesh);

        const box = new THREE.Box3().setFromObject(mesh);
        collisionBoxes.push(box);
        return mesh;
    }

    function createPillar(x, z) {
        const h = 4;
        const w = 0.8;
        const geometry = new THREE.BoxGeometry(w, h, w);
        
        const mesh = new THREE.Mesh(geometry, wallMaterial);
        mesh.position.set(x, h/2, z);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        
        const stripGeo = new THREE.BoxGeometry(w + 0.05, 0.4, w + 0.05);
        const stripMat = new THREE.MeshStandardMaterial({
            color: 0x00e5ff, // Vivid cyan glow
            emissive: 0x00e5ff,
            emissiveIntensity: 2.5
        });
        const strip = new THREE.Mesh(stripGeo, stripMat);
        strip.position.y = 2; 
        mesh.add(strip);

        // Illuminates the surrounding walls
        const light = new THREE.PointLight(0x00e5ff, 2.5, 12);
        light.position.y = 2;
        mesh.add(light);

        scene.add(mesh);
        const box = new THREE.Box3().setFromObject(mesh);
        collisionBoxes.push(box);
    }

    // Build Environment
    const floorGeo = new THREE.PlaneGeometry(100, 100);
    const floorMesh = new THREE.Mesh(floorGeo, floorMaterial);
    floorMesh.rotation.x = -Math.PI / 2;
    floorMesh.receiveShadow = true;
    scene.add(floorMesh);
    
    // Outer Walls (The Room)
    createWall(50, 6, 1, 0, -25);
    createWall(50, 6, 1, 0, 25); 
    createWall(1, 6, 50, -25, 0);
    createWall(1, 6, 50, 25, 0); 

    // Inner structures (A gallery layout)
    createWall(15, 3, 1, -10, -5);
    createWall(15, 3, 1, 10, 5);
    createWall(1, 3, 10, -5, 10);

    // Glowing pillars to act as light sources
    createPillar(0, -15);
    createPillar(-15, -15);
    createPillar(15, -15);
    createPillar(-15, 15);
    createPillar(15, 15);

    // Global Lighting (boosted so it's not pure darkness)
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.6); // Boosted ambient
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xfffaee, 1.2); // Warm sun-like directional
    dirLight.position.set(-15, 30, 20);
    dirLight.castShadow = true;
    
    dirLight.shadow.mapSize.width = 2048; // High res shadow
    dirLight.shadow.mapSize.height = 2048;
    dirLight.shadow.camera.near = 0.5;
    dirLight.shadow.camera.far = 100;
    dirLight.shadow.camera.left = -30;
    dirLight.shadow.camera.right = 30;
    dirLight.shadow.camera.top = 30;
    dirLight.shadow.camera.bottom = -30;
    dirLight.shadow.bias = -0.0005;
    scene.add(dirLight);

    // Movement
    const velocity = new THREE.Vector3();
    const direction = new THREE.Vector3();
    let moveForward = false;
    let moveBackward = false;
    let moveLeft = false;
    let moveRight = false;
    
    let prevTime = performance.now();
    const playerRadius = 0.5;

    document.addEventListener('keydown', (event) => {
        switch (event.code) {
            case 'ArrowUp':
            case 'KeyW':
                moveForward = true;
                break;
            case 'ArrowLeft':
            case 'KeyA':
                moveLeft = true;
                break;
            case 'ArrowDown':
            case 'KeyS':
                moveBackward = true;
                break;
            case 'ArrowRight':
            case 'KeyD':
                moveRight = true;
                break;
        }
    });

    document.addEventListener('keyup', (event) => {
        switch (event.code) {
            case 'ArrowUp':
            case 'KeyW':
                moveForward = false;
                break;
            case 'ArrowLeft':
            case 'KeyA':
                moveLeft = false;
                break;
            case 'ArrowDown':
            case 'KeyS':
                moveBackward = false;
                break;
            case 'ArrowRight':
            case 'KeyD':
                moveRight = false;
                break;
        }
    });

    function checkCollision(position) {
        const playerBox = new THREE.Box3(
            new THREE.Vector3(position.x - playerRadius, 0, position.z - playerRadius),
            new THREE.Vector3(position.x + playerRadius, 2, position.z + playerRadius)
        );

        for (const box of collisionBoxes) {
            if (playerBox.intersectsBox(box)) {
                return true;
            }
        }
        return false;
    }

    function animate() {
        requestAnimationFrame(animate);

        const time = performance.now();

        if (controls.isLocked === true) {
            const delta = Math.min((time - prevTime) / 1000, 0.1); // Cap delta to prevent huge jumps

            velocity.x -= velocity.x * 10.0 * delta; 
            velocity.z -= velocity.z * 10.0 * delta; 

            direction.z = Number(moveForward) - Number(moveBackward);
            direction.x = Number(moveRight) - Number(moveLeft);
            direction.normalize();

            const speed = 50.0;
            if (moveForward || moveBackward) velocity.z -= direction.z * speed * delta;
            if (moveLeft || moveRight) velocity.x -= direction.x * speed * delta;

            const currentObj = controls.object;
            const oldX = currentObj.position.x;
            const oldZ = currentObj.position.z;

            // X movement & collision
            currentObj.translateX(-velocity.x * delta);
            if (checkCollision(currentObj.position)) {
                currentObj.position.x = oldX; 
                velocity.x = 0; 
            }

            // Z movement & collision
            currentObj.translateZ(velocity.z * delta);
            if (checkCollision(currentObj.position)) {
                currentObj.position.z = oldZ; 
                velocity.z = 0;
            }
        }

        prevTime = time;
        renderer.render(scene, camera);
    }

    // Robust Resize Handling
    window.addEventListener('resize', () => {
        if(!camera || !renderer) return;
        width = window.innerWidth;
        height = window.innerHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
    });

    animate();
</script>

<style>
/* Layout Styles Matching other full-screen games */
html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #03050a;
}

.game-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

#game-canvas-container {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 5;
  background-color: #03050a; /* Ensure opaque background */
}

#game-canvas-container canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
    outline: none;
}

#ui-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  font-family: 'Space Grotesk', 'DM Sans', system-ui, sans-serif;
  color: #e6edf7;
  z-index: 10;
}

/* UI Elements that should receive clicks */
.game-header,
.modal-window,
.back-btn,
.sys-btn {
  pointer-events: auto;
}

#crosshair {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6px;
  height: 6px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  mix-blend-mode: difference;
  transition: all 0.12s ease;
  z-index: 20;
}

.game-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.5rem;
  background: linear-gradient(to bottom, rgba(3, 5, 10, 0.9), rgba(3, 5, 10, 0));
  z-index: 30;
}

.back-btn {
  text-decoration: none;
  color: #b9c6db;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  padding: 0.5rem 0.8rem;
  font-size: 0.9rem;
  background: rgba(16, 20, 30, 0.6);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  gap: 0.4rem;
  transition: all 0.2s var(--ease-out-expo);
}

.back-btn:hover {
    background: rgba(16, 20, 30, 0.9);
    border-color: #00e5ff;
    color: #00e5ff;
    transform: translateX(-2px);
}

.target-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: #d4deed;
    margin: 0;
}

.status-indicator {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8ea1bb;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(6, 11, 18, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    backdrop-filter: blur(8px);
}

.dot {
    width: 6px;
    height: 6px;
    background-color: #00e5ff;
    border-radius: 50%;
    box-shadow: 0 0 8px #00e5ff;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
}

/* Modals & Blocker */
.blocker {
  position: absolute;
  inset: 0;
  background: rgba(4, 7, 13, 0.85);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s var(--ease-out-expo);
  z-index: 50;
}

.blocker.visible {
  opacity: 1;
  pointer-events: auto;
}

.modal-window {
  width: min(400px, 90vw);
  background: linear-gradient(160deg, #0f1625, #080d15);
  border: 1px solid rgba(0, 229, 255, 0.25);
  border-radius: 12px;
  padding: 2rem;
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transform: translateY(20px) scale(0.95);
  transition: all 0.4s var(--ease-out-expo);
  text-align: center;
}

.blocker.visible .modal-window {
    transform: translateY(0) scale(1);
}

.modal-window h2 {
  margin: 0 0 0.5rem;
  font-family: var(--font-display);
  font-size: 1.8rem;
  color: #ffffff;
}

.modal-desc {
  margin: 0 0 1.5rem;
  color: #8ab5d7;
  font-size: 0.9rem;
  line-height: 1.4;
}

.controls-list {
  list-style: none;
  padding: 0;
  margin: 0 0 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  text-align: left;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 8px;
  padding: 1rem;
  border: 1px solid rgba(255,255,255,0.05);
}

.controls-list li {
    font-size: 0.9rem;
    color: #ced8e7;
    display: flex;
    align-items: center;
    gap: 0.8rem;
}

.controls-list li strong {
    color: #00e5ff;
    background: rgba(0, 229, 255, 0.1);
    border: 1px solid rgba(0, 229, 255, 0.2);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
}

.sys-btn {
    background: #00e5ff;
    color: #040914;
    border: none;
    padding: 0.8rem 2rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.sys-btn:hover {
    background: #5effff;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 229, 255, 0.3);
}

.sys-btn:active {
    transform: translateY(0);
}
</style>
